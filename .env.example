# Copy to .env and fill in. .env is gitignored; never commit it.

# Authenticates POST /api/jobs/ingest and POST /api/documents.
# Generate with: openssl rand -hex 32
INGEST_TOKEN=

# Optional: post-application mail tracking (main.py mail).
# GMAIL_APP_PASSWORD is a Google App Password (requires 2-Step Verification),
# NOT your account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
