{
  "name": "job-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "scrape": "./scripts/scrape.sh",
    "mail": "JOBAGENT_MAIL_FORCE=1 ./scripts/check-mail.sh",
    "scrape:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/scrape.ps1",
    "mail:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/check-mail.ps1 -Force",
    "check:profile": "node scripts/check-profile.mjs",
    "scrape:discover": "uv run --project scraper python -m jobagent_scraper.main discover",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern outputs --ignore-pattern scraper",
    "db:generate": "drizzle-kit generate",
    "db:pull": "./scripts/pull-cloud-db.sh"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jose": "6.2.12",
    "next": "16.2.6",
    "postal-mime": "2.4.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
